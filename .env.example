# Azure AI Foundry endpoint URL
AZURE_ENDPOINT=https://your-resource.openai.azure.com

# Single-model testing
AZURE_MODEL_NAME=your-model-deployment-name

# Side-by-side model comparison
AZURE_MODEL_A=gpt-5.2
AZURE_MODEL_B=gpt-5.4-mini

# LLM-as-judge (used to evaluate response quality)
AZURE_JUDGE_MODEL=gpt-5.2

# Sync vs Async content filter comparison
# Deploy the same model twice with different content filter configs in Foundry
AZURE_BASE_MODEL_FAMILY=gpt-4o
AZURE_SYNC_DEPLOYMENT=gpt-4o-sync
AZURE_ASYNC_DEPLOYMENT=gpt-4o-async
